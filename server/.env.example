PORT=8787
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Any long random string works — used to sign/verify JWTs locally (no network call).
# Generate your own with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# From a Google Cloud Console OAuth client (Web application type). The
# redirect URI must be registered EXACTLY in that client's config, and must
# match what's sent in both the initial auth request and the token exchange.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback
